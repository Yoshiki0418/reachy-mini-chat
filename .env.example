# コピーして .env を作り、各値を埋めてください。
# .env は .gitignore 済みなのでコミットされません。

OPENAI_API_KEY=sk-...

# 任意 (デフォルトあり)
# WHISPER_MODEL=base       # tiny/base/small/medium/large
# OPENAI_MODEL=gpt-4o-mini  # 例: gpt-4o, gpt-4o-mini
# SAY_VOICE=Kyoko           # macOS say -v で確認可能

# --- 新サーバー（reachy_server, 研究室 GPU マシン） ---
# ロボットと共有する認証トークン（16 文字以上）。例: python -c "import secrets; print(secrets.token_urlsafe(32))"
REACHY_SERVER_TOKEN=
# REACHY_SERVER_HOST=0.0.0.0
# REACHY_SERVER_PORT=8765
# 会話履歴（SQLite。空にするとメモリ上で再起動時に消える）と保持期限（日）
# REACHY_SERVER_HISTORY_DB=data/server/history.sqlite
# REACHY_SERVER_HISTORY_RETENTION_DAYS=14
# 自分宛てでない発話を「場の文脈」として覚えておく秒数（0 で無効。保存はしない）
# REACHY_SERVER_OVERHEARD_TTL_S=600

# --- 旧実装（pc_server / robot） ---
# SBV2 のモデル（G_*.pth・config.json・style_vectors.npy）が入ったフォルダ
# SBV2_MODEL_DIR=models/sbv2
# ロボットから見た PC のホスト名（ロボット側で環境変数として渡す）
# PC_HOST=<PC のホスト名>.local
