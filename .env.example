# コピーして .env を作り、各値を埋めてください。
# .env は .gitignore 済みなのでコミットされません。

OPENAI_API_KEY=sk-...

# 任意 (デフォルトあり)
# WHISPER_MODEL=base       # tiny/base/small/medium/large
# OPENAI_MODEL=gpt-4o-mini  # 例: gpt-4o, gpt-4o-mini
# SAY_VOICE=Kyoko           # macOS say -v で確認可能

# --- 新サーバー（reachy_server, 研究室 GPU マシン） ---
# ロボットと共有する認証トークン（16 文字以上）。例: python -c "import secrets; print(secrets.token_urlsafe(32))"
REACHY_SERVER_TOKEN=
# REACHY_SERVER_HOST=0.0.0.0
# REACHY_SERVER_PORT=8765
# 会話履歴（SQLite。空にするとメモリ上で再起動時に消える）と保持期限（日）
# REACHY_SERVER_HISTORY_DB=data/server/history.sqlite
# REACHY_SERVER_HISTORY_RETENTION_DAYS=14
# 自分宛てでない発話を「場の文脈」として覚えておく秒数（0 で無効。保存はしない）
# REACHY_SERVER_OVERHEARD_TTL_S=600

# STT を本物にする: uv sync --package reachy-server --group gpu のあと REACHY_SERVER_STT=faster-whisper
# REACHY_SERVER_STT=faster-whisper
# REACHY_SERVER_STT_MODEL=kotoba-tech/kotoba-whisper-v2.0-faster
# REACHY_SERVER_STT_COMPUTE_TYPE=float16   # 未指定なら GPU は float16、CPU は int8
# REACHY_SERVER_STT_BEAM_SIZE=1
# GPU は共用機なので、起動時に空きメモリがこの値以上で使用率の低い GPU を選ぶ（手で選ぶなら CUDA_VISIBLE_DEVICES）
# REACHY_SERVER_GPU_MIN_FREE_MIB=8000

# TTS を本物にする: ~/Irodori-TTS に専用の環境を作り（uv sync --extra cu128）、話者の参照音声を置いて
# REACHY_SERVER_TTS=irodori。声は参照音声で固定する（実在の人の声は使わない）
# REACHY_SERVER_TTS=irodori
# REACHY_SERVER_IRODORI_DIR=~/Irodori-TTS
# REACHY_SERVER_TTS_REF_WAV=data/server/voice/reference.wav
# REACHY_SERVER_TTS_CHECKPOINT=Aratako/Irodori-TTS-v4.1-Small-MF
# REACHY_SERVER_TTS_PRECISION=fp32

# --- 旧実装（pc_server / robot） ---
# SBV2 のモデル（G_*.pth・config.json・style_vectors.npy）が入ったフォルダ
# SBV2_MODEL_DIR=models/sbv2
# ロボットから見た PC のホスト名（ロボット側で環境変数として渡す）
# PC_HOST=<PC のホスト名>.local
